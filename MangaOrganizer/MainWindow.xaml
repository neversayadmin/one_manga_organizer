<Window x:Class="MangaOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manga CBZ Organizer"
        Height="680" Width="820"
        MinHeight="540" MinWidth="640"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>   <!-- Input folder -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>   <!-- Mode panel -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>      <!-- Groups tree -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>   <!-- Output folder -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>   <!-- Progress + Merge -->
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="📚" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="Manga CBZ Organizer"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Merge .cbz files by volume or chapter groups"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- ── Source Folder ── -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="SOURCE FOLDER"
                           FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SourceFolderBox"
                             Grid.Column="0"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="2"
                            Content="Browse"
                            Style="{StaticResource SecondaryButton}"
                            Click="BrowseSource_Click"/>

                    <Button Grid.Column="4"
                            x:Name="ScanButton"
                            Content="Scan"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="False"
                            Click="Scan_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Mode Panel ── -->
        <Border Grid.Row="4"
                x:Name="ModePanel"
                Visibility="Collapsed"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="GROUPING MODE"
                           FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Mode indicator -->
                    <Border x:Name="ModeIndicator"
                            CornerRadius="4" Padding="10,4"
                            Background="{StaticResource AccentBrush}">
                        <TextBlock x:Name="ModeLabel"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>

                    <!-- Chapters per group (chapter-only mode) -->
                    <StackPanel x:Name="ChaptersPerGroupPanel"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                Margin="16,0,0,0">
                        <TextBlock Text="Chapters per group:"
                                   FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBox x:Name="ChaptersPerGroupBox"
                                 Width="60"
                                 Text="10"
                                 VerticalContentAlignment="Center"
                                 PreviewTextInput="NumberOnly_PreviewTextInput"
                                 TextChanged="ChaptersPerGroup_Changed"/>
                    </StackPanel>

                    <TextBlock x:Name="FileCountLabel"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>

                    <CheckBox x:Name="MergeAllInOneCheck"
                              Content="Merge into single CBZ"
                              FontSize="12"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              VerticalAlignment="Center"
                              Margin="16,0,0,0"
                              Checked="MergeAllInOne_Changed"
                              Unchecked="MergeAllInOne_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Groups Preview ── -->
        <Border Grid.Row="6"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="MERGE PREVIEW"
                           FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TreeView x:Name="GroupsTree"
                              VirtualizingStackPanel.IsVirtualizing="True">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="True"/>
                            </Style>
                        </TreeView.Resources>
                    </TreeView>
                </ScrollViewer>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState"
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="📂"
                               FontSize="36"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Select a folder and click Scan to preview groups"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Output Folder ── -->
        <Border Grid.Row="8"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="OUTPUT FOLDER"
                           FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="OutputFolderBox"
                             Grid.Column="0"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="2"
                            Content="Browse"
                            Style="{StaticResource SecondaryButton}"
                            Click="BrowseOutput_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Progress + Merge Button ── -->
        <Border Grid.Row="10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status row -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusLabel"
                               Grid.Column="0"
                               Text="Ready"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                Visibility="Collapsed"
                                Margin="0,0,8,0"
                                Click="Cancel_Click"/>
                        <Button x:Name="MergeButton"
                                Content="Merge All"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="False"
                                Click="Merge_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Progress bar -->
                <ProgressBar Grid.Row="2"
                             x:Name="ProgressBar"
                             Minimum="0" Maximum="100" Value="0"/>
            </Grid>
        </Border>

    </Grid>
</Window>
